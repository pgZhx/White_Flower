# WebRTC voice ICE servers. TURN is required for reliable audio across mobile,
# carrier-grade NAT and restrictive networks.
VITE_VOICE_STUN_URLS=stun:stun.l.google.com:19302
VITE_VOICE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
VITE_VOICE_TURN_USERNAME=white-flower
VITE_VOICE_TURN_CREDENTIAL=replace-with-a-strong-secret
